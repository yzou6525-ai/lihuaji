# Copy through deploy.sh. Never commit the resulting .env.
# deploy.sh generates FOUR different 64-character hexadecimal secrets below.
# Hexadecimal DB/Redis passwords avoid URI escaping errors; production-check.py rejects placeholders.
APP_ENV=production
APP_SECRET=REPLACE_WITH_RANDOM_64_HEX
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
REDIS_PASSWORD=REPLACE_WITH_RANDOM_HEX
LLM_API_KEY=REPLACE_WITH_RANDOM_HEX
ADMIN_USER=admin
ADMIN_PASSWORD=REPLACE_WITH_AT_LEAST_16_CHARACTERS
# Must exactly match the HTTPS domain supplied to deploy.sh.
PUBLIC_BASE_URL=https://embroidery.example.com
# Production Compose also fixes DEMO_MODE=0, so it cannot seed public demo logins.
DEMO_MODE=0
PAYMENT_MODE=disabled
# Change PAYMENT_MODE to live only after configuring and testing both the chosen merchant channel and refunds.
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_CERT_SERIAL=
WECHAT_PRIVATE_KEY_FILE=/run/secrets/wechat/apiclient_key.pem
WECHAT_PLATFORM_PUBLIC_KEY_FILE=/run/secrets/wechat/wechat-platform-public.pem
WECHAT_PLATFORM_KEY_ID=
WECHAT_API_V3_KEY=
# direct: authorized ordinary merchant; partner: authorized service provider credentials above.
# Never substitute a sub-merchant number for the service provider signing identity.
WECHAT_ACCESS_MODE=direct
WECHAT_SUB_MCH_ID=
WECHAT_SUB_APP_ID=
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY_FILE=/run/secrets/alipay-private.pem
ALIPAY_PUBLIC_KEY_FILE=/run/secrets/alipay-public.pem
EXPORT_SEED_SQL=0
